# Dev-runtime image: installs full deps and runs Next's dev server with hot reload.
# Source is bind-mounted at runtime by docker-compose.dev.yml — no build/COPY of app code here.
FROM node:22-slim
WORKDIR /app
COPY package.json ./
RUN npm install
EXPOSE 5173
CMD ["node_modules/.bin/next", "dev", "-p", "5173"]
