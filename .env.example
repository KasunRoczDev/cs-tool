# Values for docker-compose.yml when deploying to a real domain (not localhost).
# Copy to `.env` in this same directory on the production host, then:
#   docker compose up -d
# docker compose reads .env automatically — no need to edit docker-compose.yml.

# Must match the origin the dashboard is actually served from, or passkey
# (WebAuthn) requests fail with "'rp.id' cannot be used with the current origin".
# RP_ID is the bare hostname (no scheme/port); ORIGIN is the full URL.
WEBAUTHN_RP_ID=cs.oms.parallaxtec.dev
WEBAUTHN_ORIGIN=https://cs.oms.parallaxtec.dev

# CORS origin(s) the backend accepts requests from. Comma-separate for multiple.
DASHBOARD_ORIGIN=https://cs.oms.parallaxtec.dev
